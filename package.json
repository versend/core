{
  "name": "versend-recode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:server": "turbo run dev -F server --",
    "env:generate": "varlock codegen --path ./apps/server/",
    "postinstall": "varlock codegen --path ./apps/server/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "catalog:",
    "@versend-recode/config": "workspace:*",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
