{
  "name": "versend-recode",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev -F api --",
    "dev:docs": "turbo run dev -F docs --",
    "env:generate": "bun --bun varlock codegen --path ./apps/api/",
    "postinstall": "bun --bun varlock codegen --path ./apps/api/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "catalog:",
    "@versend-recode/config": "workspace:*",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-react-doctor": "^0.9.16",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
