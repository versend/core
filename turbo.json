{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "CI",
    "DISCORD_WEBHOOK_AVATAR_URL",
    "DISCORD_WEBHOOK_URL",
    "DISCORD_WEBHOOK_USERNAME",
    "FILTER_EVENTS",
    "FILTER_EVENTS_EXCLUDE",
    "FILTER_TARGETS",
    "GOTIFY_TOKEN",
    "GOTIFY_URL",
    "NODE_ENV",
    "NTFY_TOKEN",
    "NTFY_URL",
    "PORT",
    "RATE_LIMIT_REQUESTS",
    "RATE_LIMIT_WINDOW_SECONDS",
    "SLACK_WEBHOOK_URL",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "WEBHOOK_INTEGRATION_SECRET",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
