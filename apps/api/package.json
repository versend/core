{
  "name": "api",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile api",
    "dev": "bun --bun varlock run -- bun --hot src/index.ts",
    "env:generate": "bun --bun varlock codegen",
    "start": "bun --bun varlock run -- bun dist/index.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@versend-recode/config": "workspace:*",
    "bun-types": "1.4.3",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
